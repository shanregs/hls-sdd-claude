        {
          "name": "Update Permission Grant",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"granted\": true\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/identity/permission-matrix/MANAGER/DASHBOARD/VIEW",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "identity",
                "permission-matrix",
                "MANAGER",
                "DASHBOARD",
                "VIEW"
              ],
              "query": []
            },
            "description": "Path is /{role}/{module}/{action}. 409 if it would remove the last IDENTITY_PERMISSIONS.EDIT grant."
          }
        }
      ]
    },

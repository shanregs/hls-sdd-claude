# Copy to .env.prod on the VM and fill in. Never commit .env.prod.

# PostgreSQL password (long and random: openssl rand -base64 24)
DB_PASSWORD=

# Base64 JWT signing key, at least 32 bytes: openssl rand -base64 48
JWT_SECRET=

# Cloudflare Zero Trust > Networks > Tunnels > your tunnel > token. The tunnel's public hostname points to http://frontend:80
TUNNEL_TOKEN=

# SMS: msg91 for real sends, or dev-stub (logs the code, sends nothing) with placeholder keys.
SMS_PROVIDER=msg91
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
